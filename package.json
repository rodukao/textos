  "version": "0.1.0",
  "description": "Editor de textos de código aberto compatível com o Microsoft Word (.docx), para web e desktop.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodukao/textos.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
